		{"id":"e71b5ef00128c387","fromNode":"b0b524d7097cc2d3","fromSide":"bottom","toNode":"e75bdf46020ef5d4","toSide":"top","label":"Фейл"},
		{"id":"4714c394664e3110","fromNode":"ae30373eff314ff6","fromSide":"right","toNode":"b98db0d8f84e8b91","toSide":"left","label":"О СЕБЕ"},
		{"id":"08509b22d86dbb53","fromNode":"ae30373eff314ff6","fromSide":"left","toNode":"81eb454956185918","toSide":"right","label":"Как пришел"},
		{"id":"880f793a146519f1","fromNode":"ae30373eff314ff6","fromSide":"left","toNode":"0b8d4175a3ed1533","toSide":"right","label":"Увольнение"},
		{"id":"5152efc616592b19","fromNode":"ae30373eff314ff6","fromSide":"bottom","toNode":"b0b524d7097cc2d3","toSide":"top","label":"HR вопросы"},
		{"id":"d9608a44fe7af14f","fromNode":"b0b524d7097cc2d3","fromSide":"bottom","toNode":"c2e07f1bf1f80822","toSide":"top","label":"Самая сложная задача?\nпереход с монолита на микросервисы"},
		{"id":"1660d29ce0fde173","fromNode":"c2e07f1bf1f80822","fromSide":"bottom","toNode":"ab6319b07622010a","toSide":"top","label":"То есть в апреле переходили на микросервисы во время вашей работы?"},
		{"id":"faf3cbd512ebffa9","fromNode":"b98db0d8f84e8b91","fromSide":"right","toNode":"8550364b44e9f116","toSide":"left","label":"Что такое errgroup"}
	]
}